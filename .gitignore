# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
htmlcov/
.coverage

# Generated. Both are published by CI as build artifacts, verified against a
# real seeded database — committing them would only create drift.
backend/openapi.json
backend/fixtures/

# Node (testing/testcamera keeps its own .gitignore too)
node_modules/
.expo/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Mobile workspace
mobile/**/node_modules/
mobile/**/.expo/
mobile/**/android/
mobile/**/ios/

# Developer-only InsightFace model preparation cache
testing/face-models/cache/
*.onnx
buffalo_l*.zip
