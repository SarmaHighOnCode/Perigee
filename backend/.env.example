# Perigee Core — environment template.
# Copy to .env and fill in. NEVER commit .env.

APP_ENV=development

# Hard flag. The server refuses to start if unset. There is no default.
DATASET_MODE=synthetic

# Neon: use the POOLED connection string (-pooler in the host).
# Local: postgresql://perigee:perigee@localhost:5432/perigee
DATABASE_URL=

# Mixed into device-key hashing. Rotating it invalidates every device key.
DEVICE_KEY_PEPPER=

# Comma-separated allowlist. A vector from any other model is rejected 422,
# never silently searched — embeddings from different models are not comparable.
ALLOWED_MODEL_IDS=insightface/w600k_r50@1

# Scoring. Served to clients via GET /v1/config; never hardcoded in an app.
QUALITY_FLOOR=0.35
BAND_NO_MATCH=0.28
BAND_WEAK=0.42
BAND_REVIEW=0.58
AMBIGUITY_GAP=0.05

SEARCH_TOP_K_DEFAULT=5
SEARCH_TOP_K_MIN=3
SEARCH_PENDING_LIMIT=3
SEARCH_EXPIRY_MINUTES=30

# Retain probe embeddings for audit replay. Default off (data minimisation).
# The probe PHOTOGRAPH is never stored under any setting — it never reaches
# the server at all.
RETAIN_PROBE_EMBEDDING=false

# Object storage for enrolled mugshots. Leave blank to run without R2:
# storage degrades to a disabled backend and media endpoints return 503.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PRESIGN_GET_TTL=120
R2_PRESIGN_PUT_TTL=300
MEDIA_MAX_BYTES=2097152

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Test-only. When unset, DB integration tests skip instead of failing.
PERIGEE_TEST_DATABASE_URL=
