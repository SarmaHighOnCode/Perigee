{
  "name": "@perigee/field",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "build:debug": "cd android && gradlew.bat app:assembleDebug",
    "build:release": "cd android && gradlew.bat app:assembleRelease",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "0.4.2",
    "@expo-google-fonts/martian-mono": "0.4.2",
    "@expo-google-fonts/public-sans": "0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@perigee/api-client": "workspace:*",
    "@perigee/camera": "workspace:*",
    "@perigee/design-tokens": "workspace:*",
    "@perigee/face": "workspace:*",
    "@perigee/ui": "workspace:*",
    "@shopify/react-native-skia": "2.2.12",
    "@tanstack/react-query": "5.101.4",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-blob-util": "0.24.10",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-image": "0.15.1",
    "react-native-nitro-modules": "0.36.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-vision-camera": "5.2.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eas-cli": "^21.7.1",
    "typescript": "~5.9.2",
    "vitest": "4.1.10"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-image"
        ]
      }
    }
  }
}
