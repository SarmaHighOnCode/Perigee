{
  "name": "@perigee/field",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "build:release": "cd android && gradlew.bat app:assembleRelease",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@perigee/api-client": "workspace:*",
    "@perigee/camera": "workspace:*",
    "@perigee/design-tokens": "workspace:*",
    "@perigee/face": "workspace:*",
    "@perigee/ui": "workspace:*",
    "expo": "~54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.9",
    "expo-file-system": "~19.0.23",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.12",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-nitro-modules": "0.36.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-vision-camera": "5.2.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": { "enabled": false }
    }
  }
}
