+    /**
+     * DownloadManager's numeric IDs are held in a process-local map. A caller can
+     * persist a unique request title before enqueue and use it to cancel an
+     * abandoned task after the React Native process has restarted.
+     */
+    private static void removeDownloadManagerTasksByTitle(String title) {
+        Context appCtx = ReactNativeBlobUtilImpl.RCTContext.getApplicationContext();
+        DownloadManager dm = (DownloadManager) appCtx.getSystemService(Context.DOWNLOAD_SERVICE);
+        DownloadManager.Query query = new DownloadManager.Query();
+        Cursor cursor = dm.query(query);
+        if (cursor == null) return;
+
+        ArrayList<Long> matchingIds = new ArrayList<>();
+        try {
+            int idColumn = cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_ID);
+            int titleColumn = cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_TITLE);
+            while (cursor.moveToNext()) {
+                if (title.equals(cursor.getString(titleColumn))) {
+                    matchingIds.add(cursor.getLong(idColumn));
+                }
+            }
+        } finally {
+            cursor.close();
+        }
+
+        for (Long id : matchingIds) {
+            dm.remove(id.longValue());
         }
